{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "accounts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "folders": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "inbox",
          "sent",
          "drafts",
          "archive",
          "spam",
          "trash",
          "other"
        ]
      }
    },
    "events": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redact": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "default": "propose_only",
      "type": "string",
      "enum": [
        "propose_only",
        "direct"
      ]
    },
    "publish": {
      "default": false,
      "type": "boolean"
    },
    "expires_at": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "accounts",
    "folders",
    "events",
    "actions",
    "redact",
    "mode",
    "publish",
    "expires_at"
  ],
  "additionalProperties": false,
  "$id": "https://email-engine.dev/spec/token.json",
  "title": "token",
  "description": "A scoped token: what one consumer may see and do. Empty lists mean all."
}
