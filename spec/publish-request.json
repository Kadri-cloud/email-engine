{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_.-]*$"
    },
    "account": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    },
    "payload": {}
  },
  "required": [
    "type",
    "account",
    "payload"
  ],
  "additionalProperties": false,
  "$id": "https://email-engine.dev/spec/publish-request.json",
  "title": "publish-request",
  "description": "A derived event published by a plug-in to POST /events."
}
