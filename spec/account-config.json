              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "user": {
              "type": "string"
            },
            "pass": {
              "type": "string"
            },
            "accept_any_recipient": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "host",
            "port",
            "accept_any_recipient"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "provider",
        "address",
        "inbound"
      ],
      "additionalProperties": false
    },
