{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "imap"
        },
        "address": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "imap": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "default": 993,
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "secure": {
              "default": true,
              "type": "boolean"
            },
            "user": {
              "type": "string"
            },
            "pass": {
              "type": "string"
            },
            "oauth": {
              "type": "object",
              "properties": {
                "token_url": {
                  "type": "string",
                  "format": "uri"
                },
                "client_id": {
                  "type": "string"
                },
                "client_secret": {
                  "type": "string"
                },
                "refresh_token": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              },
              "required": [
                "token_url",
                "client_id",
                "refresh_token"
              ],
              "additionalProperties": false
            },
            "insecure_tls": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "host",
            "port",
            "secure",
            "user",
            "insecure_tls"
          ],
          "additionalProperties": false
        },
        "smtp": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "default": 587,
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "secure": {
              "default": false,
              "type": "boolean"
            },
            "user": {
              "type": "string"
            },
            "pass": {
              "type": "string"
            }
          },
          "required": [
            "host",
            "port",
            "secure",
            "user"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "provider",
        "address",
        "imap"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
