            },
            "refresh_token": {
              "type": "string"
            },
            "poll_seconds": {
              "default": 30,
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991
            },
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "token_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "client_id",
            "refresh_token",
            "poll_seconds"
          ],
          "additionalProperties": false
