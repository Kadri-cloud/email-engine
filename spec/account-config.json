            },
            "token_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "tenant",
            "client_id",
            "refresh_token",
            "poll_seconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "provider",
        "address",
        "graph"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://email-engine.dev/spec/account-config.json",
  "title": "account-config",
  "description": "Account configuration accepted by POST /accounts, one shape per provider."
}
