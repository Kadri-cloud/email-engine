{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "message.received": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "folder_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "from": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "address"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "address"
            ],
            "additionalProperties": false
          }
        },
        "cc": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "address"
            ],
            "additionalProperties": false
          }
        },
        "subject": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "flags": {
          "type": "object",
          "properties": {
            "seen": {
              "type": "boolean"
            },
            "flagged": {
              "type": "boolean"
            },
            "answered": {
              "type": "boolean"
            },
            "draft": {
              "type": "boolean"
            }
          },
          "required": [
            "seen",
            "flagged",
            "answered",
            "draft"
          ],
          "additionalProperties": false
        },
        "trust": {
          "type": "string",
          "enum": [
            "verified",
            "known",
            "unverified",
            "suspicious"
          ]
        },
        "has_attachments": {
          "type": "boolean"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "message_id",
        "thread_id",
        "folder_ids",
        "from",
        "to",
        "cc",
        "subject",
        "date",
        "snippet",
        "flags",
        "trust",
        "has_attachments",
        "size"
      ],
      "additionalProperties": false
    },
    "message.updated": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "folder_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changes": {
          "type": "object",
          "properties": {
            "flags": {
              "type": "object",
              "properties": {
                "before": {
                  "type": "object",
                  "properties": {
                    "seen": {
                      "type": "boolean"
                    },
                    "flagged": {
                      "type": "boolean"
                    },
                    "answered": {
                      "type": "boolean"
                    },
                    "draft": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "seen",
                    "flagged",
                    "answered",
                    "draft"
                  ],
                  "additionalProperties": false
                },
                "after": {
                  "type": "object",
                  "properties": {
                    "seen": {
                      "type": "boolean"
                    },
                    "flagged": {
                      "type": "boolean"
                    },
                    "answered": {
                      "type": "boolean"
                    },
                    "draft": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "seen",
                    "flagged",
                    "answered",
                    "draft"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "before",
                "after"
              ],
              "additionalProperties": false
            },
            "folder_ids": {
              "type": "object",
              "properties": {
                "before": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "before",
                "after"
              ],
              "additionalProperties": false
            },
            "tags": {
              "type": "object",
              "properties": {
                "before": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "before",
                "after"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "message_id",
        "thread_id",
        "folder_ids",
        "changes"
      ],
      "additionalProperties": false
    },
    "message.deleted": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "folder_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "message_id",
        "thread_id",
        "folder_ids"
      ],
      "additionalProperties": false
    },
    "thread.updated": {
      "type": "object",
      "properties": {
        "thread_id": {
          "type": "string"
        },
        "message_count": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "address"
            ],
            "additionalProperties": false
          }
        },
        "last_activity": {
          "type": "string"
        },
        "cause_cursor": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "thread_id",
        "message_count",
        "participants",
        "last_activity",
        "cause_cursor"
      ],
      "additionalProperties": false
    },
    "action.updated": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string"
        },
        "client_key": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "previous_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "requested_by": {
          "type": "string"
        },
        "result": {},
        "error": {
          "type": "string"
        },
        "undo_deadline": {
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "client_key",
        "type",
        "previous_status",
        "status",
        "requested_by"
      ],
      "additionalProperties": false
    },
    "account.status": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "connected",
            "syncing",
            "auth_expired",
            "rate_limited",
            "disconnected",
            "disabled"
          ]
        },
        "capabilities": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "folders": {
                  "type": "string",
                  "enum": [
                    "folders",
                    "labels"
                  ]
                },
                "push": {
                  "type": "string",
                  "enum": [
                    "idle",
                    "jmap",
                    "pubsub",
                    "graph",
                    "smtp",
                    "none"
                  ]
                },
                "incremental_sync": {
                  "type": "string",
                  "enum": [
                    "qresync",
                    "condstore",
                    "uidnext",
                    "history",
                    "delta",
                    "none"
                  ]
                },
                "undo_send_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "server_rules": {
                  "type": "string",
                  "enum": [
                    "sieve",
                    "gmail_filters",
                    "none"
                  ]
                },
                "max_connections": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "send_limit_per_day": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "threads": {
                  "type": "string",
                  "enum": [
                    "native",
                    "hint",
                    "none"
                  ]
                },
                "permanent_delete": {
                  "type": "boolean"
                },
                "sent_copy": {
                  "type": "string",
                  "enum": [
                    "client",
                    "server"
                  ]
                }
              },
              "required": [
                "folders",
                "push",
                "incremental_sync",
                "undo_send_seconds",
                "server_rules",
                "max_connections",
                "send_limit_per_day",
                "threads",
                "permanent_delete",
                "sent_copy"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "last_sync": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "status",
        "capabilities",
        "last_sync"
      ],
      "additionalProperties": false
    },
    "timer.fired": {
      "type": "object",
      "properties": {
        "timer_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "payload": {},
        "created_by": {
          "type": "string"
        }
      },
      "required": [
        "timer_id",
        "event_type",
        "payload",
        "created_by"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "message.received",
    "message.updated",
    "message.deleted",
    "thread.updated",
    "action.updated",
    "account.status",
    "timer.fired"
  ],
  "additionalProperties": false,
  "$id": "https://email-engine.dev/spec/event-payloads.json",
  "title": "event-payloads",
  "description": "Payload schema per core event type. Derived events from plug-ins use namespaced types and their own payloads."
}
